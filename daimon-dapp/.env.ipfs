# The IPFS mirror build (npm run build:ipfs, docs/IPFS_MIRROR.md) takes its
# NEXT_PUBLIC_* values from THIS committed file, never from .env.local, so the
# same commit yields the same bytes and the same CID on any machine.
# Everything here ships to the browser: no secret can ever go in this file.

# The mirror is the mainnet app.
NEXT_PUBLIC_CHAIN_ID=56

# WalletConnect Cloud project id for the mirror: EMPTY until the project
# decides which id the mirror ships with (IPFS_MIRROR.md, "WalletConnect").
# Empty = the mirror offers injected wallets only (browser extensions and
# wallets' in-app browsers), no WalletConnect pairing.
NEXT_PUBLIC_WC_PROJECT_ID=

# Active chain: 97 = BSC testnet (default), 56 = BSC mainnet.
# Read at BUILD time (NEXT_PUBLIC_*): changing it needs a rebuild/redeploy.
NEXT_PUBLIC_CHAIN_ID=97

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Optional: without it, MetaMask/Trust remain available via injected.
# A public identifier, not a secret. Nothing secret ever goes in this file:
# every NEXT_PUBLIC_* value ships to the browser.
NEXT_PUBLIC_WC_PROJECT_ID=
